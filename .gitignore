# ==== Python 字节码与缓存 ====
__pycache__/
*.py[cod]
*$py.class
*.so

# ==== 虚拟环境 ====
.venv/
venv/
env/
ENV/

# ==== 本地数据库（SQLite 文件随程序生成，不应入库）====
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ==== 环境变量与密钥 ====
.env
.env.*
!.env.example

# ==== 日志 ====
*.log
logs/

# ==== 测试与类型检查缓存 ====
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==== 打包产物 ====
build/
dist/
*.egg-info/
.eggs/

# ==== 编辑器 / IDE ====
.idea/
.vscode/
*.swp
*.swo

# ==== 操作系统 ====
.DS_Store
Thumbs.db
desktop.ini
